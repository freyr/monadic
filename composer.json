{
    "name": "freyr/monadic",
    "description": "A PHP library for monadic operations.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.0",
        "symplify/easy-coding-standard": "^13.3",
        "infection/infection": "^0.35"
    },
    "autoload": {
        "psr-4": {
            "Freyr\\Monadic\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "Freyr\\Monadic\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "ecs check",
        "check": [
            "@test",
            "@stan",
            "@cs"
        ],
        "coverage": [
            "phpunit --no-progress --coverage-clover var/coverage/clover.xml",
            "@php tools/check-coverage.php var/coverage/clover.xml 100"
        ],
        "infection": "infection --threads=max --with-uncovered",
        "example": "@php examples/user-service.php"
    }
}
